<Application
  x:Class="HassanTraders.Desktop.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- WPF-UI base (kept for window chrome, scroll bars, tooltips, icons); our design system overrides what matters. -->
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <!-- Colour tokens. IThemeApplier swaps this dictionary for Colors.Dark.xaml. Keep the path in sync with WpfThemeApplier. -->
        <ResourceDictionary Source="Resources/Themes/Colors.Light.xaml" />
        <ResourceDictionary Source="Resources/DesignSystem.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
