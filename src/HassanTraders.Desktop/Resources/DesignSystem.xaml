<!--
  Single entry point of the design system. App.xaml merges this file once.
  Order matters only for BasedOn references (Typography before others that use it, Buttons before Navigation).
  Colour dictionaries (Themes/Colors.*.xaml) are merged separately by App.xaml and swapped at runtime.
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Styles/Brushes.xaml" />
    <ResourceDictionary Source="Styles/Tokens.xaml" />
    <ResourceDictionary Source="Styles/Typography.xaml" />
    <ResourceDictionary Source="Styles/Buttons.xaml" />
    <ResourceDictionary Source="Styles/Inputs.xaml" />
    <ResourceDictionary Source="Styles/Forms.xaml" />
    <ResourceDictionary Source="Styles/DataGrid.xaml" />
    <ResourceDictionary Source="Styles/Cards.xaml" />
    <ResourceDictionary Source="Styles/Progress.xaml" />
    <ResourceDictionary Source="Styles/Navigation.xaml" />
    <ResourceDictionary Source="Styles/Dialogs.xaml" />
    <ResourceDictionary Source="Styles/Pills.xaml" />
    <ResourceDictionary Source="Styles/Icons.xaml" />
    <ResourceDictionary Source="Styles/Converters.xaml" />
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
