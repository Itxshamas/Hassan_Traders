<!-- FormField template (control lives in Common/Controls/FormField.cs). Implicit style: a plain <controls:FormField> is on-brand. -->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:HassanTraders.Desktop.Common.Controls">

  <Style TargetType="controls:FormField">
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:FormField">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Label}" Text="{TemplateBinding Label}" />
            <ContentPresenter />
            <TextBlock
              x:Name="ErrorText"
              Margin="0,6,0,0"
              Style="{StaticResource Text.Error}"
              Text="{TemplateBinding Error}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Error" Value="{x:Null}">
              <Setter TargetName="ErrorText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding Error.Length, RelativeSource={RelativeSource Self}, FallbackValue=0}" Value="0">
              <Setter TargetName="ErrorText" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
