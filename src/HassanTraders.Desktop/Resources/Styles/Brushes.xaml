<!-- Brushes for every colour token. Colour is a DynamicResource so swapping the theme colour dictionary re-colours the whole UI live. -->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Brush.Sidebar" Color="{DynamicResource Color.Sidebar}" />
  <SolidColorBrush x:Key="Brush.SidebarHover" Color="{DynamicResource Color.SidebarHover}" />
  <SolidColorBrush x:Key="Brush.SidebarActive" Color="{DynamicResource Color.SidebarActive}" />
  <SolidColorBrush x:Key="Brush.SidebarText" Color="{DynamicResource Color.SidebarText}" />
  <SolidColorBrush x:Key="Brush.SidebarTextActive" Color="{DynamicResource Color.SidebarTextActive}" />
  <SolidColorBrush x:Key="Brush.SidebarAccent" Color="{DynamicResource Color.SidebarAccent}" />
  <SolidColorBrush x:Key="Brush.SidebarBorder" Color="{DynamicResource Color.SidebarBorder}" />
  <SolidColorBrush x:Key="Brush.Primary" Color="{DynamicResource Color.Primary}" />
  <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{DynamicResource Color.PrimaryHover}" />
  <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{DynamicResource Color.PrimaryPressed}" />
  <SolidColorBrush x:Key="Brush.PrimaryTint" Color="{DynamicResource Color.PrimaryTint}" />
  <SolidColorBrush x:Key="Brush.OnPrimary" Color="{DynamicResource Color.OnPrimary}" />
  <SolidColorBrush x:Key="Brush.AppBackground" Color="{DynamicResource Color.AppBackground}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{DynamicResource Color.SurfaceAlt}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{DynamicResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="{DynamicResource Color.BorderStrong}" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{DynamicResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="{DynamicResource Color.TextDisabled}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.SuccessBg" Color="{DynamicResource Color.SuccessBg}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.WarningBg" Color="{DynamicResource Color.WarningBg}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.DangerHover" Color="{DynamicResource Color.DangerHover}" />
  <SolidColorBrush x:Key="Brush.DangerBg" Color="{DynamicResource Color.DangerBg}" />
  <SolidColorBrush x:Key="Brush.OnDanger" Color="{DynamicResource Color.OnDanger}" />
  <SolidColorBrush x:Key="Brush.Info" Color="{DynamicResource Color.Info}" />
  <SolidColorBrush x:Key="Brush.InfoBg" Color="{DynamicResource Color.InfoBg}" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="{DynamicResource Color.Overlay}" />
  <SolidColorBrush x:Key="Brush.Shadow" Color="{DynamicResource Color.Shadow}" />
</ResourceDictionary>
