<!--
  Surfaces. Card = white panel with hairline border and soft shadow. Use Divider between sections inside a card.
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
    <Setter Property="Padding" Value="{DynamicResource Pad.Card}" />
    <Setter Property="Effect" Value="{DynamicResource Shadow.Card}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Card that holds a DataGrid or other edge-to-edge content: clips children to the rounded corners -->
  <Style x:Key="Card.Flush" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Margin" Value="0,16" />
  </Style>

  <!-- Page background: use on the root of every page -->
  <Style x:Key="Page" TargetType="Grid">
    <Setter Property="Background" Value="{DynamicResource Brush.AppBackground}" />
  </Style>
</ResourceDictionary>
