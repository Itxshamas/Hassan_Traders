<!-- TextBlock styles. Always use these; never set FontSize/FontWeight/Foreground ad hoc on screens. -->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="Text.Page" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Page}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.Section" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Section}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>

  <!-- Field label above an input -->
  <Style x:Key="Text.Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="Text.Error" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Big numbers on stat cards -->
  <Style x:Key="Text.Kpi" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Kpi}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <!-- Numbers in tables: tabular digits. Pair with FlowDirection=LeftToRight + HorizontalAlignment=Right. -->
  <Style x:Key="Text.Number" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="FlowDirection" Value="LeftToRight" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
