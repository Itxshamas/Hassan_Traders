<!-- Hassan Traders colour tokens: DARK theme.
     The ONLY place raw hex colours may appear. Both theme files must define exactly the same keys
     (a unit test enforces this). Change the brand colour here and nowhere else. -->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Sidebar">#060F1C</Color>
  <Color x:Key="Color.SidebarHover">#0F2440</Color>
  <Color x:Key="Color.SidebarActive">#163457</Color>
  <Color x:Key="Color.SidebarText">#B4C3D8</Color>
  <Color x:Key="Color.SidebarTextActive">#FFFFFF</Color>
  <Color x:Key="Color.SidebarAccent">#3FB8D9</Color>
  <Color x:Key="Color.SidebarBorder">#142A47</Color>
  <Color x:Key="Color.Primary">#4DA3D9</Color>
  <Color x:Key="Color.PrimaryHover">#6BB5E2</Color>
  <Color x:Key="Color.PrimaryPressed">#3C8DC2</Color>
  <Color x:Key="Color.PrimaryTint">#17324D</Color>
  <Color x:Key="Color.OnPrimary">#06223A</Color>
  <Color x:Key="Color.AppBackground">#0A1626</Color>
  <Color x:Key="Color.Surface">#12233A</Color>
  <Color x:Key="Color.SurfaceAlt">#172C47</Color>
  <Color x:Key="Color.SurfaceHover">#1B3352</Color>
  <Color x:Key="Color.Border">#243A58</Color>
  <Color x:Key="Color.BorderStrong">#345074</Color>
  <Color x:Key="Color.TextPrimary">#E8EEF6</Color>
  <Color x:Key="Color.TextSecondary">#A8B6C8</Color>
  <Color x:Key="Color.TextMuted">#8A9BB0</Color>
  <Color x:Key="Color.TextDisabled">#5E6F85</Color>
  <Color x:Key="Color.Success">#3DBE82</Color>
  <Color x:Key="Color.SuccessBg">#12362A</Color>
  <Color x:Key="Color.Warning">#E0A83A</Color>
  <Color x:Key="Color.WarningBg">#3A2E12</Color>
  <Color x:Key="Color.Danger">#EF6B77</Color>
  <Color x:Key="Color.DangerHover">#F58A93</Color>
  <Color x:Key="Color.DangerBg">#3E1A20</Color>
  <Color x:Key="Color.OnDanger">#2A0A0E</Color>
  <Color x:Key="Color.Info">#6FA0E0</Color>
  <Color x:Key="Color.InfoBg">#17284A</Color>
  <Color x:Key="Color.Overlay">#B2020912</Color>
  <Color x:Key="Color.Shadow">#000000</Color>
</ResourceDictionary>
