<!-- Hassan Traders colour tokens: LIGHT theme.
     The ONLY place raw hex colours may appear. Both theme files must define exactly the same keys
     (a unit test enforces this). Change the brand colour here and nowhere else. -->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Sidebar">#0B1F3A</Color>
  <Color x:Key="Color.SidebarHover">#12305A</Color>
  <Color x:Key="Color.SidebarActive">#1A4075</Color>
  <Color x:Key="Color.SidebarText">#C9D6E8</Color>
  <Color x:Key="Color.SidebarTextActive">#FFFFFF</Color>
  <Color x:Key="Color.SidebarAccent">#3FB8D9</Color>
  <Color x:Key="Color.SidebarBorder">#1A3558</Color>
  <Color x:Key="Color.Primary">#0B6FA4</Color>
  <Color x:Key="Color.PrimaryHover">#095C8A</Color>
  <Color x:Key="Color.PrimaryPressed">#07496E</Color>
  <Color x:Key="Color.PrimaryTint">#E6F2F8</Color>
  <Color x:Key="Color.OnPrimary">#FFFFFF</Color>
  <Color x:Key="Color.AppBackground">#F4F6F9</Color>
  <Color x:Key="Color.Surface">#FFFFFF</Color>
  <Color x:Key="Color.SurfaceAlt">#F8FAFC</Color>
  <Color x:Key="Color.SurfaceHover">#F1F5F9</Color>
  <Color x:Key="Color.Border">#DDE3EB</Color>
  <Color x:Key="Color.BorderStrong">#C3CCD8</Color>
  <Color x:Key="Color.TextPrimary">#14202E</Color>
  <Color x:Key="Color.TextSecondary">#4A5A6D</Color>
  <Color x:Key="Color.TextMuted">#5F6F82</Color>
  <Color x:Key="Color.TextDisabled">#9AA7B6</Color>
  <Color x:Key="Color.Success">#17784A</Color>
  <Color x:Key="Color.SuccessBg">#E3F4EC</Color>
  <Color x:Key="Color.Warning">#9A6414</Color>
  <Color x:Key="Color.WarningBg">#FDF3DC</Color>
  <Color x:Key="Color.Danger">#C62F3E</Color>
  <Color x:Key="Color.DangerHover">#A82533</Color>
  <Color x:Key="Color.DangerBg">#FBE6E8</Color>
  <Color x:Key="Color.OnDanger">#FFFFFF</Color>
  <Color x:Key="Color.Info">#34639F</Color>
  <Color x:Key="Color.InfoBg">#E8EFF9</Color>
  <Color x:Key="Color.Overlay">#990B1F3A</Color>
  <Color x:Key="Color.Shadow">#0B1F3A</Color>
</ResourceDictionary>
