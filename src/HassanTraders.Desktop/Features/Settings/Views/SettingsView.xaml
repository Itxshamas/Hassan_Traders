<UserControl
  x:Class="HassanTraders.Desktop.Features.Settings.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:wpf="clr-namespace:HassanTraders.Desktop.Common.Helpers"
  xmlns:controls="clr-namespace:HassanTraders.Desktop.Common.Controls">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Margin="{DynamicResource Pad.Page}" HorizontalAlignment="Left">
      <controls:PageHeader Title="{wpf:T Settings_Title}" Subtitle="{wpf:T Settings_Subtitle}" />

      <controls:StatusBanner Margin="0,0,0,16" Message="{Binding ErrorMessage}" Tone="Danger" />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Section}" Text="{wpf:T Settings_Appearance}" />

          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="{wpf:T Settings_Language}" />
              <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{wpf:T Settings_LanguageHint}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button
                MinWidth="120"
                Margin="0,0,8,0"
                Command="{Binding SetLanguageCommand}"
                CommandParameter="en"
                Content="{wpf:T Common_English}"
                Style="{StaticResource Button.Segment}"
                Tag="{Binding IsEnglish}" />
              <Button
                MinWidth="120"
                Command="{Binding SetLanguageCommand}"
                CommandParameter="ur"
                Content="{wpf:T Common_Urdu}"
                Style="{StaticResource Button.Segment}"
                Tag="{Binding IsUrdu}" />
            </StackPanel>
          </Grid>

          <Border Style="{StaticResource Divider}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="{wpf:T Settings_Theme}" />
              <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{wpf:T Settings_ThemeHint}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button
                MinWidth="120"
                Margin="0,0,8,0"
                Command="{Binding SetThemeCommand}"
                CommandParameter="light"
                Content="{wpf:T Common_Light}"
                Style="{StaticResource Button.Segment}"
                Tag="{Binding IsLight}" />
              <Button
                MinWidth="120"
                Command="{Binding SetThemeCommand}"
                CommandParameter="dark"
                Content="{wpf:T Common_Dark}"
                Style="{StaticResource Button.Segment}"
                Tag="{Binding IsDark}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
