<UserControl
  x:Class="HassanTraders.Desktop.Features.Login.LoginView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:wpf="clr-namespace:HassanTraders.Desktop.Common.Helpers"
  xmlns:controls="clr-namespace:HassanTraders.Desktop.Common.Controls">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Brand panel -->
    <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" Padding="40">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1">
          <Border
            Width="64"
            Height="64"
            Margin="0,0,0,24"
            HorizontalAlignment="Left"
            Background="{DynamicResource Brush.Primary}"
            CornerRadius="16">
            <ui:SymbolIcon
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="{DynamicResource Icon.Hero}"
              Foreground="{DynamicResource Brush.OnPrimary}"
              Symbol="ShoppingBag24" />
          </Border>
          <TextBlock
            FontSize="34"
            FontWeight="Bold"
            Foreground="{DynamicResource Brush.SidebarTextActive}"
            Text="{wpf:T App_Title}"
            TextWrapping="Wrap" />
          <Border
            Width="48"
            Height="3"
            Margin="0,16,0,16"
            HorizontalAlignment="Left"
            Background="{DynamicResource Brush.SidebarAccent}"
            CornerRadius="2" />
          <TextBlock
            FontSize="16"
            Foreground="{DynamicResource Brush.SidebarText}"
            Text="{wpf:T App_Subtitle}"
            TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Form -->
    <Grid Grid.Column="1">
      <Button
        Margin="24"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Command="{Binding ToggleLanguageCommand}"
        Content="{Binding OtherLanguageLabel}"
        Style="{StaticResource Button.Ghost}" />

      <Border
        Width="400"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="32"
        Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Margin="0,0,0,24" Style="{StaticResource Text.Page}" Text="{wpf:T Login_Title}" />

          <controls:StatusBanner Margin="0,0,0,16" Message="{Binding ErrorMessage}" Tone="Danger" />

          <controls:FormField Label="{wpf:T Login_Username}">
            <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
          </controls:FormField>

          <controls:FormField Label="{wpf:T Login_Password}" Margin="0,0,0,24">
            <PasswordBox controls:PasswordBoxBinder.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </controls:FormField>

          <Button
            MinHeight="44"
            Command="{Binding LoginCommand}"
            Content="{Binding LoginButtonText}"
            IsDefault="True"
            Style="{StaticResource Button.Primary}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
