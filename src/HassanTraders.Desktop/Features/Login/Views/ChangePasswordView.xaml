<UserControl
  x:Class="HassanTraders.Desktop.Features.Login.ChangePasswordView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:wpf="clr-namespace:HassanTraders.Desktop.Common.Helpers"
  xmlns:controls="clr-namespace:HassanTraders.Desktop.Common.Controls">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border
      Width="480"
      Margin="0,32"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Padding="32"
      Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Style="{StaticResource Text.Page}" Text="{wpf:T ChangePw_Title}" TextWrapping="Wrap" />
        <controls:StatusBanner Margin="0,16,0,20" Message="{wpf:T ChangePw_Hint}" Tone="Info" />

        <controls:StatusBanner Margin="0,0,0,16" Message="{Binding ErrorMessage}" Tone="Danger" />

        <controls:FormField Label="{wpf:T ChangePw_Current}">
          <PasswordBox controls:PasswordBoxBinder.BoundPassword="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
        <controls:FormField Label="{wpf:T ChangePw_New}">
          <PasswordBox controls:PasswordBoxBinder.BoundPassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
        <controls:FormField Label="{wpf:T ChangePw_Confirm}" Margin="0,0,0,24">
          <PasswordBox controls:PasswordBoxBinder.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>

        <Button
          MinHeight="44"
          Command="{Binding SaveCommand}"
          Content="{wpf:T ChangePw_Button}"
          IsDefault="True"
          Style="{StaticResource Button.Primary}" />
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
