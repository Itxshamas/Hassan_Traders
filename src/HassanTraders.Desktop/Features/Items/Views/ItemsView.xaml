<UserControl
  x:Class="HassanTraders.Desktop.Features.Items.ItemsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:wpf="clr-namespace:HassanTraders.Desktop.Common.Helpers"
  xmlns:controls="clr-namespace:HassanTraders.Desktop.Common.Controls">

  <!--
    Reference list screen: PageHeader, filter card, results card with DataGrid and StateViews.
    New list screens (customers, purchases, ...) copy this structure.
  -->
  <Grid Margin="{DynamicResource Pad.Page}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" />

    <!-- Filters -->
    <Border Grid.Row="1" Margin="0,0,0,16" Padding="16" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:SearchBox Placeholder="{wpf:T Items_Search}" Text="{Binding SearchText, Mode=TwoWay}" />
        <ComboBox
          Grid.Column="2"
          DisplayMemberPath="Label"
          ItemsSource="{Binding CategoryOptions}"
          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
        <ComboBox
          Grid.Column="4"
          DisplayMemberPath="Label"
          IsEnabled="{Binding HasTypes}"
          ItemsSource="{Binding TypeOptions}"
          SelectedItem="{Binding SelectedType, Mode=TwoWay}" />
        <Button
          Grid.Column="6"
          Command="{Binding ClearFiltersCommand}"
          Content="{wpf:T Items_ClearFilters}"
          IsEnabled="{Binding HasActiveFilter}"
          Style="{StaticResource Button.Ghost}" />
      </Grid>
    </Border>

    <!-- Results -->
    <Border Grid.Row="2" Style="{StaticResource Card.Flush}">
      <Grid>
        <DataGrid
          ItemsSource="{Binding Rows}"
          Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibility}}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="*" MinWidth="240" Header="{wpf:T Items_ColItem}" SortMemberPath="PrimaryName">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,6">
                    <TextBlock FontWeight="SemiBold" Text="{Binding PrimaryName}" TextTrimming="CharacterEllipsis" />
                    <!-- Second line is the other language; Urdu keeps Nastaliq even on an English screen -->
                    <TextBlock
                      HorizontalAlignment="Left"
                      FlowDirection="{Binding SecondaryIsUrdu, Converter={StaticResource BoolToFlowDirection}}"
                      FontFamily="{Binding SecondaryIsUrdu, Converter={StaticResource BoolToFontFamily}}"
                      FontSize="{DynamicResource FontSize.Caption}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      LineHeight="{Binding SecondaryIsUrdu, Converter={StaticResource BoolToLineHeight}, ConverterParameter=26}"
                      Text="{Binding SecondaryName}"
                      TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Width="170" Header="{wpf:T Items_ColCategory}" SortMemberPath="CategoryLabel">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding CategoryLabel}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                      Style="{StaticResource Text.Caption}"
                      Text="{Binding TypeLabel}"
                      TextTrimming="CharacterEllipsis"
                      Visibility="{Binding HasTypeLabel, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Width="110" Binding="{Binding Brand}" Header="{wpf:T Items_ColBrand}" />

            <DataGridTemplateColumn Width="140" Header="{wpf:T Items_ColPack}" SortMemberPath="PackLabel">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding PackLabel}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                      Style="{StaticResource Text.Caption}"
                      Text="{Binding VariantsText}"
                      Visibility="{Binding HasVariants, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Width="110" Header="{wpf:T Items_ColCost}" SortMemberPath="CostPaisa">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Text.Number}" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding CostText}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Width="120" Header="{wpf:T Items_ColPrice}" SortMemberPath="SalePaisa">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Text.Number}" FontWeight="SemiBold" Text="{Binding PriceText}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Width="110" Header="{wpf:T Items_ColReorder}" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Text.Number}" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ReorderText}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Width="110" Header="{wpf:T Items_ColStatus}" SortMemberPath="StatusText">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:StatusPill Text="{Binding StatusText}">
                    <controls:StatusPill.Style>
                      <Style TargetType="controls:StatusPill">
                        <Setter Property="Tone" Value="Neutral" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Tone" Value="Success" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </controls:StatusPill.Style>
                  </controls:StatusPill>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <controls:StateView
          Kind="Loading"
          Title="{wpf:T Items_LoadingTitle}"
          Message="{wpf:T Items_LoadingMessage}"
          Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />

        <controls:StateView
          Kind="Error"
          Title="{wpf:T Items_ErrorTitle}"
          Message="{wpf:T Items_ErrorMessage}"
          Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibility}}">
          <controls:StateView.Action>
            <Button Command="{Binding RetryCommand}" Content="{wpf:T Items_Retry}" Style="{StaticResource Button.Primary}" />
          </controls:StateView.Action>
        </controls:StateView>

        <controls:StateView
          IconName="Box24"
          Title="{wpf:T Items_EmptyTitle}"
          Message="{wpf:T Items_EmptyMessage}"
          Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}" />

        <controls:StateView
          IconName="Search24"
          Title="{wpf:T Items_NoMatchTitle}"
          Message="{wpf:T Items_NoMatchMessage}"
          Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVisibility}}">
          <controls:StateView.Action>
            <Button Command="{Binding ClearFiltersCommand}" Content="{wpf:T Items_ClearFilters}" />
          </controls:StateView.Action>
        </controls:StateView>
      </Grid>
    </Border>
  </Grid>
</UserControl>
