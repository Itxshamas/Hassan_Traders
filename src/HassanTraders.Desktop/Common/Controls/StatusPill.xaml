<UserControl
  x:Class="HassanTraders.Desktop.Common.Controls.StatusPill"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="Pill" Style="{StaticResource Pill.Border}">
    <TextBlock
      x:Name="Caption"
      Style="{StaticResource Pill.Text}"
      Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}" />
  </Border>
</UserControl>
