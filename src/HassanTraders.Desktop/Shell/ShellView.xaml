<UserControl
  x:Class="HassanTraders.Desktop.Shell.ShellView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:wpf="clr-namespace:HassanTraders.Desktop.Common.Helpers"
  xmlns:dashboard="clr-namespace:HassanTraders.Desktop.Features.Dashboard"
  xmlns:items="clr-namespace:HassanTraders.Desktop.Features.Items"
  xmlns:settings="clr-namespace:HassanTraders.Desktop.Features.Settings"
  xmlns:shell="clr-namespace:HassanTraders.Desktop.Shell">

  <!-- Every page ViewModel the navigation can create is mapped to its view here. Add new pages here. -->
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type shell:PlaceholderViewModel}">
      <shell:PlaceholderView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
      <dashboard:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type items:ItemsViewModel}">
      <items:ItemsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
      <settings:SettingsView />
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{DynamicResource Size.Sidebar}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand -->
        <StackPanel Grid.Row="0" Margin="20,20,20,20" Orientation="Horizontal">
          <Border
            Width="40"
            Height="40"
            Margin="0,0,12,0"
            Background="{DynamicResource Brush.Primary}"
            CornerRadius="10">
            <ui:SymbolIcon
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="{DynamicResource Icon.Large}"
              Foreground="{DynamicResource Brush.OnPrimary}"
              Symbol="ShoppingBag24" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              FontSize="17"
              FontWeight="Bold"
              Foreground="{DynamicResource Brush.SidebarTextActive}"
              Text="{wpf:T App_Title}" />
            <TextBlock
              FontSize="{DynamicResource FontSize.Caption}"
              Foreground="{DynamicResource Brush.SidebarText}"
              Text="{wpf:T App_Subtitle}" />
          </StackPanel>
        </StackPanel>

        <!-- Navigation -->
        <ListBox
          Grid.Row="1"
          Margin="12,0"
          ItemsSource="{Binding NavItems}"
          SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
          Style="{StaticResource Nav.List}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                  Margin="0,0,14,0"
                  VerticalAlignment="Center"
                  FontSize="{DynamicResource Icon.Medium}"
                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                  Symbol="{Binding IconName, Converter={StaticResource SymbolName}}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- User and session -->
        <Border
          Grid.Row="2"
          Padding="16"
          BorderBrush="{DynamicResource Brush.SidebarBorder}"
          BorderThickness="0,1,0,0">
          <StackPanel>
            <TextBlock
              FontWeight="SemiBold"
              Foreground="{DynamicResource Brush.SidebarTextActive}"
              Text="{Binding UserName}"
              TextTrimming="CharacterEllipsis" />
            <TextBlock
              Margin="0,2,0,12"
              FontSize="{DynamicResource FontSize.Caption}"
              Foreground="{DynamicResource Brush.SidebarText}"
              Text="{Binding RoleLabel}" />
            <Button
              Margin="0,0,0,8"
              Command="{Binding ToggleLanguageCommand}"
              Content="{Binding OtherLanguageLabel}"
              Style="{StaticResource Button.Sidebar}" />
            <Button
              Command="{Binding SignOutCommand}"
              Content="{wpf:T Common_SignOut}"
              Style="{StaticResource Button.Sidebar}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Page -->
    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" IsTabStop="False" />
  </Grid>
</UserControl>
